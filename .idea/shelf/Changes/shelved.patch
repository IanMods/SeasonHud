<+>plugins {\r\n    id 'com.gradleup.shadow'\r\n    id 'org.jetbrains.gradle.plugin.idea-ext'\r\n    id 'net.darkhax.curseforgegradle'\r\n    id \"com.modrinth.minotaur\"\r\n}\r\n\r\nloom {\r\n    forge {\r\n        mixinConfig \"seasonhud.mixins.json\"\r\n        mixinConfig \"seasonhud.forge.mixins.json\"\r\n    }\r\n}\r\n\r\narchitectury {\r\n    platformSetupLoomIde()\r\n    forge()\r\n}\r\n\r\nconfigurations {\r\n    common {\r\n        canBeResolved = true\r\n        canBeConsumed = false\r\n    }\r\n    compileClasspath.extendsFrom common\r\n    runtimeClasspath.extendsFrom common\r\n    developmentForge.extendsFrom common\r\n\r\n    // Files in this configuration will be bundled into your mod using the Shadow plugin.\r\n    // Don't use the `shadow` configuration from the plugin itself as it's meant for excluding files.\r\n    shadowBundle {\r\n        canBeResolved = true\r\n        canBeConsumed = false\r\n    }\r\n\r\n    configureEach {\r\n        resolutionStrategy.force(\"net.sf.jopt-simple:jopt-simple:5.0.4\")\r\n    }\r\n}\r\n\r\nrepositories {\r\n    maven {\r\n        name = 'Forge'\r\n        url = 'https://maven.minecraftforge.net'\r\n    }\r\n}\r\n\r\ndependencies {\r\n    forge \"net.minecraftforge:forge:${project.minecraft_version}-${project.forge_version}\"\r\n\r\n    common(project(path: ':common', configuration: 'namedElements')) { transitive false }\r\n    shadowBundle project(path: ':common', configuration: 'transformProductionForge')\r\n\r\n    modRuntimeOnly(\"me.djtheredstoner:DevAuth-forge-latest:${devauth_version}\")\r\n\r\n    //Serene Seasons\r\n    modCompileOnly \"maven.modrinth:serene-seasons:${project.serene_seasons_version}-forge\"\r\n    modCompileOnly \"maven.modrinth:glitchcore:${project.glitchcore_version}-forge\"\r\n    compileOnly(\"net.jodah:typetools:0.6.3\")\r\n\r\n    //Terrafirmacraft\r\n    modCompileOnly \"maven.modrinth:terrafirmacraft:${project.terrafirmacraft_version}\"\r\n    modCompileOnly \"maven.modrinth:patchouli:${project.patchouli_version}-neoforge\"\r\n    modCompileOnly \"maven.modrinth:barrels-2012:${project.barrels_version}\"\r\n\r\n    //Ecliptic Seasons\r\n    modCompileOnly \"curse.maven:ecliptic-seasons-1118306:${project.ecliptic_seasons_version}\"\r\n\r\n    //Xaero's Minimap\r\n    modCompileOnly \"maven.modrinth:xaeros-minimap:${project.xaeros_minimap_version}_Forge_1.21.5\"\r\n\r\n    //JourneyMap\r\n    compileOnly group: 'info.journeymap', name: 'journeymap-api-forge', version: project.journeymap_api_version, changing: true\r\n    modCompileOnly \"maven.modrinth:journeymap:1.21.5-${project.journeymap_version}+forge\"\r\n\r\n    //Forge Config API Port\r\n    modImplementation \"maven.modrinth:forge-config-api-port:v${project.forge_config_api_port_version}-${project.minecraft_version}-Forge\"\r\n\r\n    // Development QOL\r\n//    modLocalRuntime(\"mezz.jei:jei-${project.minecraft_version}-forge:${project.jei_version}\") { transitive = false }\r\n\r\n    // Minimap Mod Dev Tests\r\n    // See root gradle.properties to choose which to use at runtime.\r\n    switch (project.minimap_mod.toLowerCase(Locale.ROOT)) {\r\n        case \"xaero\":\r\n            modLocalRuntime \"maven.modrinth:xaeros-minimap:${project.xaeros_minimap_version}_Forge_1.21.5\"\r\n            break\r\n        case \"journey\":\r\n            modImplementation group: 'info.journeymap', name: 'journeymap-api-forge', version: project.journeymap_api_version, changing: true\r\n            modImplementation(\"maven.modrinth:journeymap:1.21.5-${project.journeymap_version}+forge\")\r\n            modImplementation(\"maven.modrinth:common-network:${project.common_network_version}-forge\")\r\n            break\r\n        case \"ftb\":\r\n            break\r\n        case \"atlas\":\r\n            break\r\n        case \"none\":\r\n            break\r\n        default: println(\"Unknown minimap mod specified: ${project.minimap_mod}. Must be xaero, journey, ftb, \" +\r\n                \"atlas, or none\")\r\n    }\r\n\r\n    // Accessory Mod Dev Tests\r\n    // See root gradle.properties to choose which to use at runtime.\r\n    switch (project.accessory_mod.toLowerCase(Locale.ROOT)) {\r\n        case \"accessories\":\r\n            modLocalRuntime(\"io.wispforest:accessories-neoforge:${project.accessories_version}\") {\r\n                transitive = false\r\n            }\r\n            modLocalRuntime \"me.shedaniel.cloth:cloth-config-forge:${project.cloth_config_version}\"\r\n            modApi(\"dev.su5ed.sinytra.fabric-api:fabric-api-base:0.4.31+ef105b4977\") {\r\n                exclude group: \"dev.su5ed.sinytra.fabric-api\"\r\n            }\r\n\r\n            modApi(\"dev.su5ed.sinytra.fabric-api:fabric-data-attachment-api-v1:1.0.0+30ef839e77\") {\r\n                exclude group: \"dev.su5ed.sinytra.fabric-api\"\r\n            }\r\n            modApi(\"dev.su5ed.sinytra.fabric-api:fabric-entity-events-v1:1.6.0+6274ab9d77\") {\r\n                exclude group: \"dev.su5ed.sinytra.fabric-api\"\r\n            }\r\n            modApi(\"dev.su5ed.sinytra.fabric-api:fabric-object-builder-api-v1:11.1.3+2174fc8477\") {\r\n                exclude group: \"dev.su5ed.sinytra.fabric-api\"\r\n            }\r\n            forgeRuntimeLibrary(\"io.wispforest:endec:0.1.8\")\r\n            forgeRuntimeLibrary(\"io.wispforest.endec:gson:0.1.5\")\r\n            forgeRuntimeLibrary(\"io.wispforest.endec:netty:0.1.4\")\r\n            implementation(\"io.github.llamalad7:mixinextras-forge:0.3.5\")\r\n            break\r\n        case \"none\":\r\n            break\r\n        default: println(\"Unknown accessory mod specified: ${project.minimap_mod}. Must be accessories, or none\")\r\n    }\r\n\r\n    // Season Mod Dev Tests (Forge)\r\n    // See root gradle.properties to choose which to use at runtime.\r\n    switch (project.season_mod_forge.toLowerCase(Locale.ROOT)) {\r\n        case \"serene\":\r\n            modImplementation \"maven.modrinth:serene-seasons:${project.serene_seasons_version}-forge\"\r\n            modImplementation \"maven.modrinth:glitchcore:${project.glitchcore_version}-forge\"\r\n            implementation(\"net.jodah:typetools:0.6.3\")\r\n            break\r\n        case \"terra\":\r\n            modImplementation \"maven.modrinth:terrafirmacraft:${project.terrafirmacraft_version}\"\r\n            modImplementation \"maven.modrinth:patchouli:${project.patchouli_version}-neoforge\"\r\n            //modImplementation \"maven.modrinth:curios:${project.curios_version}\"\r\n            modImplementation \"maven.modrinth:barrels-2012:${project.barrels_version}\"\r\n            break\r\n        case \"ecliptic\":\r\n            modImplementation \"curse.maven:ecliptic-seasons-1118306:${project.ecliptic_seasons_version}\"\r\n            break\r\n        default: println(\"Unknown season mod specified: ${project.minimap_mod}. Must be serene, terra, or ecliptic\")\r\n    }\r\n}\r\n\r\nshadowJar {\r\n    configurations = [project.configurations.shadowBundle]\r\n    archiveClassifier = 'dev-shadow'\r\n}\r\n\r\nremapJar {\r\n    inputFile.set shadowJar.archiveFile\r\n}\r\n\r\nmodrinth {\r\n    debugMode = false\r\n    token = System.getenv(\"MODRINTH_TOKEN\")\r\n    projectId = modrinth_forge_id\r\n    versionNumber = minecraft_version + \"-\" + version\r\n    versionName = base.archivesName.get() + \"-\" + mod_version\r\n    versionType = \"release\"\r\n    uploadFile = remapJar\r\n\r\n    List<String> mcVersions = modrinth_gameVersions.split(\",\")\r\n    gameVersions = mcVersions\r\n    loaders = [\"forge\"]\r\n\r\n    changelog = projectDir.toPath().getParent().resolve(\"LATEST_CHANGELOG.md\").getText()\r\n\r\n    dependencies {\r\n        optional.project \"serene-seasons\"\r\n        optional.project \"terrafirmacraft\"\r\n        required.project \"forge-config-api-port\"\r\n        optional.project \"curios\"\r\n        optional.project \"accessories\"\r\n        optional.project \"xaeros-minimap\"\r\n        optional.project \"xaeros-minimap-fair\"\r\n        optional.project \"journeymap\"\r\n        optional.project \"map-atlases\"\r\n    }\r\n}\r\n\r\ntasks.register('publishCurseForge', net.darkhax.curseforgegradle.TaskPublishCurseForge) {\r\n    group = \"curseforge\"\r\n\r\n    debugMode = false\r\n    disableVersionDetection()\r\n    apiToken = System.getenv(\"CURSEFORGE_TOKEN\")\r\n\r\n    def mainFile = upload(curseforge_forge_id, remapJar)\r\n    mainFile.changelogType = \"markdown\"\r\n    mainFile.changelog = projectDir.toPath().getParent().resolve(\"LATEST_CHANGELOG.md\").getText()\r\n    mainFile.releaseType = \"release\"\r\n\r\n    List<String> mcVersions = curseforge_gameVersions.split(\",\")\r\n    mainFile.gameVersions = mcVersions\r\n    mainFile.addGameVersion(\"Forge\")\r\n    mainFile.addJavaVersion(\"Java 21\")\r\n\r\n    mainFile.addOptional(\"serene-seasons\")\r\n    mainFile.addOptional(\"terrafirmacraft\")\r\n    mainFile.addOptional(\"ecliptic-seasons\")\r\n    mainFile.addRequirement(\"forge-config-api-port-fabric\")\r\n    mainFile.addOptional(\"curios\")\r\n    mainFile.addOptional(\"accessories\")\r\n    mainFile.addOptional(\"xaeros-minimap\")\r\n    mainFile.addOptional(\"xaeros-minimap-fair-play-edition\")\r\n    mainFile.addOptional(\"ftb-chunks-forge\")\r\n    mainFile.addOptional(\"journeymap\")\r\n    mainFile.addOptional(\"map-atlases-forge\")\r\n}\r\n\r\ntasks.register('publishForge') {\r\n    group = \"upload\"\r\n    afterEvaluate {\r\n        dependsOn(tasks.publishCurseForge)\r\n        dependsOn(tasks.modrinth)\r\n    }\r\n}
