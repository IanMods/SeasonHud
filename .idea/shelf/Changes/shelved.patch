<+>architectury {\r\n    common enabled_platforms.split(',')\r\n}\r\n\r\ndependencies {\r\n    // We depend on Fabric Loader here to use the Fabric @Environment annotations,\r\n    // which get remapped to the correct annotations on each platform.\r\n    // Do NOT use other classes from Fabric Loader.\r\n    modImplementation \"net.fabricmc:fabric-loader:${project.fabric_loader_version}\"\r\n    compileOnly annotationProcessor(\"io.github.llamalad7:mixinextras-common:0.5.0\")\r\n\r\n    compileOnlyApi group: 'info.journeymap', name: 'journeymap-api-common', version: project.journeymap_api_version, changing: true\r\n    compileOnly \"com.github.glitchfiend:GlitchCore-common:${minecraft_version}-${glitchcore_version}\"\r\n    modCompileOnly \"io.wispforest:accessories-common:${project.accessories_version}-mojmap\"\r\n    modCompileOnly \"top.theillusivec4.curios:curios-neoforge:${project.curios_version}\"\r\n    //modCompileOnly \"maven.modrinth:accessories-cc-layer:7.4.0-beta.18\"\r\n    modCompileOnly \"dev.emi:trinkets:${project.trinkets_version}\"\r\n\r\n    //Config API\r\n    annotationProcessor compileOnlyApi(\"io.wispforest:owo-lib:${project.owo_version}\")\r\n\r\n    //Lets me use config value in common for mods using NeoForge configs\r\n    compileOnlyApi(\"fuzs.forgeconfigapiport:forgeconfigapiport-common-neoforgeapi:${project.forge_config_api_port_version}\")\r\n\r\n    // Minimap Mods\r\n    // Not used in common unless they are actually  loaded.\r\n    modCompileOnly \"maven.modrinth:xaeros-minimap:${project.xaeros_minimap_version}_NeoForge_1.21.5\"\r\n    modCompileOnly \"curse.maven:ftb-chunks-forge-314906:${project.ftb_chunks_neoforge_version}\"\r\n    modCompileOnly \"curse.maven:ftb-library-forge-404465:${project.ftb_library_neoforge_version}\"\r\n    modCompileOnly \"maven.modrinth:journeymap:1.21.5-${project.journeymap_version}+neoforge\"\r\n    modCompileOnly \"maven.modrinth:map-atlases-forge:neoforge_1.21-${project.map_atlases_version}\"\r\n\r\n    //Season Mods\r\n    // Not used in common unless they are actually  loaded.\r\n    modCompileOnly \"maven.modrinth:serene-seasons:${project.serene_seasons_version}-neoforge\"\r\n    modCompileOnly \"maven.modrinth:glitchcore:${project.glitchcore_version}-neoforge\"\r\n    modCompileOnly \"maven.modrinth:fabric-seasons:${project.fabric_seasons_version}\"\r\n    modCompileOnly \"maven.modrinth:fabric-seasons-extras:${project.fabric_seasons_extras_version}\"\r\n    modCompileOnly \"maven.modrinth:terrafirmacraft:${project.terrafirmacraft_version}\"\r\n    modCompileOnly \"curse.maven:ecliptic-seasons-1118306:${project.ecliptic_seasons_version}\"\r\n}
