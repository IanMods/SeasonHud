<+># Gradle\norg.gradle.jvmargs=-Xmx4G\norg.gradle.parallel=true\n# Project\nmod_version=1.14.0\nmod_group=club.iananderson\njava_version=21\ncredits=IanAnderson\nlicense=MIT\ndescription= This is a client-side addon that displays the current season on the HUD, or under various minimap mods.\\n\\\n  \\n\\\n  Currently supported season mods are:\\n \\\n   - Serene Seasons\\n \\\n   - Fabric Seasons\\n \\\n   - TerraFirmaCraft (Forge 1.18.2/1.20.1)\\n \\\n   - Ecliptic Seasons (Forge/Neoforge)\n# Mod options\nmod_name=SeasonHUD\nmod_author=IanAnderson\nmod_id=seasonhud\nenabled_platforms=fabric,neoforge\n# Minecraft properties\nminecraft_version=1.21.5\nminecraft_version_range=[1.21.2, 1.21.5]\n# Curseforge/Modrinth\nmodrinth_forge_id=VNjUn3NA\nmodrinth_fabric_id=iDiIfZLX\nmodrinth_gameVersions=1.21.2,1.21.3,1.21.4,1.21.5\ncurseforge_forge_id=690971\ncurseforge_fabric_id=848022\ncurseforge_gameVersions=1.21.2,1.21.3,1.21.4,1.21.5\n# Forge properties\n# https://files.minecraftforge.net/net/minecraftforge/forge/index_1.21.5.html\nforge_version=55.0.23\nforge_version_range=[51,)\nforge_loader_version_range=[51,)\n# Fabric properties\n# https://fabricmc.net/develop/\nfabric_loader_version=0.17.2\nfabric_api_version=0.128.2+1.21.5\nfabric_version_range=~1.21\n# Neoforge properties\n# https://projects.neoforged.net/neoforged/neoforge\nneoforge_version=21.5.91\nneoforge_version_range=[21.0,)\nneoforge_loader_version_range=[4,)\n# Config Api properties\n# https://modrinth.com/mod/forge-config-api-port/versions?g=1.21.5&l=fabric\n# https://docs.wispforest.io/owo/config/getting-started/\nforge_config_api_port_version=21.5.1\nowo_version=0.12.21+1.21.5\nowo_version_neoforge=0.12.21-beta.1+1.21.5\n#Season Mods\n# https://modrinth.com/mod/serene-seasons/versions?g=1.21.5&l=forge\n# https://modrinth.com/mod/glitchcore/versions?g=1.21.5&l=forge\n# https://modrinth.com/mod/fabric-seasons/versions?g=1.21.5&l=fabric\n# https://modrinth.com/mod/fabric-seasons-extras/versions?g=1.21.5&l=fabric\n# https://modrinth.com/mod/terrafirmacraft/versions?g=1.21.5&l=forge\n# https://modrinth.com/mod/patchouli/versions?g=1.21.5&l=forge\n# https://modrinth.com/mod/barrels-2012/versions?g=1.20.1&l=forge\n# https://www.curseforge.com/minecraft/mc-mods/ecliptic-seasons/files/all?page=1&pageSize=20&version=1.21.1&gameVersionTypeId=6\nserene_seasons_version=10.5.0.5\nglitchcore_version=2.5.0.1\nfabric_seasons_version=2.4.2-BETA+1.21\nfabric_seasons_extras_version=1.3.2-BETA+1.21\nterrafirmacraft_version=3.2.14\npatchouli_version=1.21-88\nbarrels_version=2.1\necliptic_seasons_version=6820204\n# Mappings\n# https://lambdaurora.dev/tools/import_quilt.html\n# https://parchmentmc.org/docs/getting-started\nqm_version=2\nparchment_version=2025.06.15\n# Minimaps - Fabric\n# https://www.curseforge.com/minecraft/mc-mods/ftb-chunks-fabric/files/all?page=1&pageSize=20&version=1.21.5\n# https://www.curseforge.com/minecraft/mc-mods/ftb-library-fabric/files/all?page=1&pageSize=20&version=1.21.5\n# https://www.curseforge.com/minecraft/mc-mods/ftb-teams-fabric/files/all?page=1&pageSize=20&version=1.21.5\nftb_chunks_fabric_version=6504892\nftb_library_fabric_version=6807432\nftb_teams_fabric_version=6119436\n# Minimaps - Forge\n# https://www.curseforge.com/minecraft/mc-mods/ftb-chunks-forge/files/all?page=1&pageSize=20&version=1.21.5\n# https://www.curseforge.com/minecraft/mc-mods/ftb-library-forge/files/all?page=1&pageSize=20&version=1.21.5\n# https://www.curseforge.com/minecraft/mc-mods/ftb-teams-forge/files/all?page=1&pageSize=20&version=1.21.5\nftb_chunks_forge_version=\nftb_library_forge_version=\nftb_teams_forge_version=\n# Minimaps - NeoForge\n# https://www.curseforge.com/minecraft/mc-mods/ftb-chunks-forge/files/all?page=1&pageSize=20&version=1.21.5\n# https://www.curseforge.com/minecraft/mc-mods/ftb-library-forge/files/all?page=1&pageSize=20&version=1.21.5\n# https://www.curseforge.com/minecraft/mc-mods/ftb-teams-forge/files/all?page=1&pageSize=20&version=1.21.5\nftb_chunks_neoforge_version=6504893\nftb_library_neoforge_version=6807431\nftb_teams_neoforge_version=6119437\n# Minimaps - Common\n# https://modrinth.com/mod/xaeros-minimap/versions?g=1.21.5&l=neoforge&l=fabric\n# https://modrinth.com/mod/journeymap/versions?g=1.21.5&l=neoforge&l=fabric\n# https://github.com/TeamJM/journeymap-api/tree/1.21.1_2.0_SNAPSHOTS\n# https://modrinth.com/mod/common-network/versions?g=1.21.5&l=neoforge&l=fabric\n# https://modrinth.com/mod/architectury-api/versions?g=1.21.5&l=neoforge&l=fabric\n# https://modrinth.com/mod/map-atlases-forge/versions?g=1.21.5&l=neoforge\n# https://modrinth.com/mod/map-atlases/versions?g=1.21.5&l=fabric\n# https://modrinth.com/mod/moonlight/versions?g=1.21.5&l=neoforge&l=fabric\n# https://modrinth.com/mod/immediatelyfast/versions?g=1.21.5&l=neoforge&l=fabric\nxaeros_minimap_version=25.2.10\njourneymap_version=6.0.0-beta.52\njourneymap_api_version=2.0.0-1.21.5-SNAPSHOT\ncommon_network_version=1.0.18-1.21.5\narchitectury_version=16.1.4\nmap_atlases_version=6.2.1\nmoonlight_version=2.20.3\nimmediatelyfast_version=1.9.3\n#Curios/Trinkets/Accessories\n# https://modrinth.com/mod/curios/versions?g=1.21.5&l=neoforge\n# https://modrinth.com/mod/trinkets/versions?g=1.21.5&l=fabric\n# https://modrinth.com/mod/accessories/versions?g=1.21.5&l=fabric\ncurios_version=11.0.1+1.21.5\ntrinkets_version=3.10.0\naccessories_version=1.3.1-beta+1.21.5\n# Development QOL\n# Create Fabric supports all 3 recipe viewers: JEI, REI, and EMI. This decides which is enabled at runtime.\n# set to disabled to have none of them.\n# JEI - https://modrinth.com/mod/jei/versions?g=1.21.5&l=fabric\n# Mod Menu - https://modrinth.com/mod/modmenu/versions?g=1.21.5&l=fabric\n# LazyDFU - https://modrinth.com/mod/lazydfu/versions?g=1.21.5&l=fabric\n# Cloth Config - https://modrinth.com/mod/cloth-config/versions?g=1.21.5&l=fabric\njei_version=19.21.0.247\nmodmenu_version=14.0.0-rc.2\nlazydfu_version=\ncloth_config_version=18.0.145\ndevauth_version=1.2.1\n# Dev season mod (NeoForge only)\n# Options: serene, terra, ecliptic\nseason_mod_neoforge=serene\n# Dev season mod (Forge only)\n# Options: serene, terra, ecliptic\nseason_mod_forge=serene\n# Dev season mod (Fabric only)\n# Options: serene, fabric\nseason_mod_fabric=serene\n# Dev minimap mod\n# Options: xaero, journey, ftb, atlas, none\nminimap_mod=xaero\n# Dev accessory mod\n# Options: accessories, none\naccessory_mod=none
