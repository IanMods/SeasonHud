<+>package club.iananderson.seasonhud.client.gui.screens;\n\nimport club.iananderson.seasonhud.Common;\nimport club.iananderson.seasonhud.client.gui.HudDetail;\nimport club.iananderson.seasonhud.client.gui.Location;\nimport club.iananderson.seasonhud.client.gui.components.sliders.BasicSlider;\nimport club.iananderson.seasonhud.client.gui.components.sliders.HudOffsetSlider;\nimport club.iananderson.seasonhud.client.gui.components.sliders.HudScaleSlider;\nimport club.iananderson.seasonhud.config.DefaultOptions;\nimport club.iananderson.seasonhud.impl.seasons.CurrentSeason;\nimport club.iananderson.seasonhud.util.TextHelper;\nimport java.util.Arrays;\nimport net.minecraft.ChatFormatting;\nimport net.minecraft.client.gui.GuiGraphics;\nimport net.minecraft.client.gui.components.CycleButton;\nimport net.minecraft.client.gui.components.EditBox;\nimport net.minecraft.client.gui.components.Tooltip;\nimport net.minecraft.client.gui.screens.Screen;\nimport net.minecraft.network.chat.Component;\nimport net.minecraft.network.chat.MutableComponent;\nimport org.jetbrains.annotations.NotNull;\n\npublic class SeasonOptionsScreen extends SeasonHudScreen {\n  private static final Component SCREEN_TITLE = TextHelper.categoryTranslation(\"seasonOptions\");\n  private Location hudLocation;\n  private int xSliderInt;\n  private int ySliderInt;\n  private double seasonScale;\n  private HudDetail hudDetail;\n  private boolean seasonColor;\n  private boolean showSubSeason;\n  private boolean showTropicalSeason;\n  private boolean needCalendar;\n  private boolean enableCalendarDetail;\n  private boolean drawDefaultHud;\n  private int dayLength;\n  private int newDayLength;\n  private CycleButton<Location> hudLocationButton;\n  private HudOffsetSlider xSlider;\n  private HudOffsetSlider ySlider;\n  private HudScaleSlider hudScaleSlider;\n  private EditBox dayLengthBox;\n\n  public SeasonOptionsScreen(Screen parentScreen) {\n    super(parentScreen, SCREEN_TITLE);\n  }\n\n  public static SeasonOptionsScreen getInstance(Screen parentScreen) {\n    return new SeasonOptionsScreen(parentScreen);\n  }\n\n  public void loadConfig() {\n    drawDefaultHud = Common.drawDefaultHudMenu();\n    seasonColor = Common.getConfig().colorOptions.enableSeasonNameColor();\n    hudLocation = Common.getConfig().hudOptions.hudLocation();\n    xSliderInt = Common.getConfig().hudOptions.hudXOffset();\n    ySliderInt = Common.getConfig().hudOptions.hudYOffset();\n    seasonScale = Common.getConfig().hudOptions.hudScale();\n    hudDetail = Common.getConfig().seasonOptions.hudDetail();\n    showSubSeason = Common.getConfig().seasonOptions.showSubSeason();\n    showTropicalSeason = Common.getConfig().seasonOptions.showTropicalSeason();\n    needCalendar = Common.getConfig().seasonOptions.needCalendar();\n    enableCalendarDetail = Common.getConfig().seasonOptions.calendarDetailMode();\n    dayLength = Common.getConfig().seasonOptions.dayLength();\n  }\n\n  public void saveConfig() {\n    if (drawDefaultHud) {\n      Common.getConfig().hudOptions.hudLocation(hudLocationButton.getValue());\n      Common.getConfig().hudOptions.hudXOffset(xSlider.getValueInt());\n      Common.getConfig().hudOptions.hudYOffset(ySlider.getValueInt());\n      Common.getConfig().hudOptions.hudScale(hudScaleSlider.getValueDouble());\n    }\n    Common.getConfig().seasonOptions.hudDetail(hudDetail);\n    Common.getConfig().colorOptions.enableSeasonNameColor(seasonColor);\n\n    if (Common.hasSubSeasons()) {\n      Common.getConfig().seasonOptions.showSubSeason(showSubSeason);\n      Common.getConfig().seasonOptions.showTropicalSeason(showTropicalSeason);\n    }\n\n    if (Common.hasCalendarLoaded()) {\n      Common.getConfig().seasonOptions.needCalendar(needCalendar);\n      Common.getConfig().seasonOptions.calendarDetailMode(enableCalendarDetail);\n    }\n\n    if (Common.fabricSeasonsLoaded()) {\n      Common.getConfig().seasonOptions.dayLength(Integer.parseInt(dayLengthBox.getValue()));\n    }\n  }\n\n  @Override\n  public void onDone() {\n    saveConfig();\n    super.onDone();\n  }\n\n  @Override\n  public void onClose() {\n    super.onClose();\n  }\n\n  //Todo - Need to fix Tropical Seasons option not updating in config screen\n  @Override\n  public void render(@NotNull GuiGraphics graphics, int mouseX, int mouseY, float partialTicks) {\n    super.render(graphics, mouseX, mouseY, partialTicks);\n\n    int x = 3;\n    int y = 3;\n    seasonScale = 1;\n    MutableComponent seasonCombined = CurrentSeason.getInstance(this.minecraft)\n        .getSeasonHudConfigText(hudDetail, showSubSeason);\n\n    if (drawDefaultHud) {\n      int DEFAULT_X_OFFSET_SCALED = DefaultOptions.X_OFFSET;\n      int DEFAULT_Y_OFFSET_SCALED = DefaultOptions.Y_OFFSET;\n      seasonScale = hudScaleSlider.getValueDouble();\n      int componentWidth = (int) (this.font.width(seasonCombined) * seasonScale);\n      int componentHeight = (int) (this.font.lineHeight * seasonScale);\n\n      boolean customLocation = (hudLocationButton.getValue() == Location.CUSTOM);\n\n      hudScaleSlider.visible = drawDefaultHud;\n\n      xSlider.active = customLocation;\n      xSlider.visible = drawDefaultHud;\n\n      ySlider.active = customLocation;\n      ySlider.visible = drawDefaultHud;\n\n      switch (hudLocation) {\n        case TOP_LEFT:\n          x = DEFAULT_X_OFFSET_SCALED;\n          y = DEFAULT_Y_OFFSET_SCALED;\n          break;\n\n        case TOP_CENTER:\n          x = (int) ((((double) width / 2) - ((double) componentWidth / 2)) / seasonScale);\n          y = DEFAULT_Y_OFFSET_SCALED;\n          break;\n\n        case TOP_RIGHT:\n          x = (int) ((width - componentWidth - DEFAULT_X_OFFSET_SCALED) / seasonScale);\n          y = DEFAULT_Y_OFFSET_SCALED;\n          break;\n\n        case BOTTOM_LEFT:\n          x = DEFAULT_X_OFFSET_SCALED;\n          y = (int) (((height - componentHeight - DEFAULT_Y_OFFSET_SCALED)) / seasonScale);\n          break;\n\n        case BOTTOM_RIGHT:\n          x = (int) (((width - componentWidth - DEFAULT_X_OFFSET_SCALED)) / seasonScale);\n          y = (int) (((height - componentHeight - DEFAULT_Y_OFFSET_SCALED)) / seasonScale);\n          break;\n\n        case CUSTOM:\n          x = (int) ((xSlider.getValueInt()));\n          y = (int) ((ySlider.getValueInt()));\n          break;\n      }\n    }\n\n    if (Common.fabricSeasonsLoaded()) {\n      graphics.drawCenteredString(font, \"Day Length\", leftButtonX + BUTTON_WIDTH / 2,\n                                  MENU_PADDING + (3 * (BUTTON_HEIGHT + BUTTON_PADDING)) - (font.lineHeight\n                                      + BUTTON_PADDING), 16777215);\n    }\n\n    super.render(graphics, mouseX, mouseY, partialTicks);\n\n    graphics.pose().pushPose();\n    graphics.pose().translate(0, 0, 50);\n    graphics.pose().scale((float) seasonScale, (float) seasonScale, 1.0F);\n    graphics.drawString(font, seasonCombined, x, y, 0xffffff);\n    graphics.pose().popPose();\n\n  }\n\n  private int maxWidth(MutableComponent seasonText) {\n    int textWidth = this.font.width(seasonText);\n\n    return (int) ((this.width - (textWidth * seasonScale)) / seasonScale);\n  }\n\n  private int maxHeight() {\n    int textHeight = this.font.lineHeight;\n\n    return (int) ((this.height - (textHeight * seasonScale)) / seasonScale);\n  }\n\n  @Override\n  public void init() {\n    loadConfig();\n    super.init();\n\n    MutableComponent seasonCombined = CurrentSeason.getInstance(this.minecraft).getSeasonHudText();\n\n    row = -1;\n\n    if (drawDefaultHud) {\n      row += 1; // Row 1\n      hudLocationButton = CycleButton.builder(Location::getHudLocationName)\n          .withTooltip(t -> Tooltip.create(TextHelper.optionTranslation(\"hudOptions\", \"hudLocation\", true)))\n          .withValues(Location.values())\n          .withInitialValue(hudLocation)\n          .create(leftButtonX, (buttonStartY + (row * yOffset)), BUTTON_WIDTH, BUTTON_HEIGHT,\n                  TextHelper.optionTranslation(\"hudOptions\", \"hudLocation\"), (b, val) -> this.hudLocation = val);\n\n      hudScaleSlider = HudScaleSlider.builder(TextHelper.optionTranslation(\"hudOptions\", \"hudScale\").append(\": \"))\n          .withTooltip(Tooltip.create(TextHelper.optionTranslation(\"hudOptions\", \"hudScale\", true)))\n          .withValueRange(DefaultOptions.HUD_SCALE_MIN, DefaultOptions.HUD_SCALE_MAX)\n          .withInitialValue(seasonScale)\n          .withDefaultValue(DefaultOptions.HUD_SCALE).withStepSize(0.5).withPrecision(1)\n          .withBounds(rightButtonX, (buttonStartY + (row * yOffset)), BUTTON_WIDTH, BUTTON_HEIGHT)\n          .build();\n\n      row += 1; // Row 2\n      xSlider = HudOffsetSlider.builder(TextHelper.optionTranslation(\"hudOptions\", \"hudXOffset\").append(\": \"))\n          .withTooltip(Tooltip.create(TextHelper.optionTranslation(\"hudOptions\", \"hudXOffset\", true)))\n          .withValues(0, this.maxWidth(seasonCombined), xSliderInt, DefaultOptions.X_OFFSET)\n          .withBounds(rightButtonX, (buttonStartY + (row * yOffset)), BUTTON_WIDTH / 2 - BasicSlider.SLIDER_PADDING,\n                      BUTTON_HEIGHT)\n          .build();\n\n      ySlider = HudOffsetSlider.builder(TextHelper.optionTranslation(\"hudOptions\", \"hudYOffset\").append(\": \"))\n          .withTooltip(Tooltip.create(TextHelper.optionTranslation(\"hudOptions\", \"hudYOffset\", true)))\n          .withValues(0, this.maxHeight(), ySliderInt, DefaultOptions.Y_OFFSET)\n          .withBounds(rightButtonX + BUTTON_WIDTH / 2 + BasicSlider.SLIDER_PADDING, (buttonStartY + (row * yOffset)),\n                      BUTTON_WIDTH / 2 - BasicSlider.SLIDER_PADDING, BUTTON_HEIGHT)\n          .build();\n\n      widgets.addAll(Arrays.asList(hudLocationButton, hudScaleSlider, xSlider, ySlider));\n    }\n\n    row += 1; // Row 3 (enableMinimapIntegration -> Row 1)\n    CycleButton<HudDetail> showDayButton = CycleButton.builder(HudDetail::getDayDisplayName)\n        .withTooltip(t -> Tooltip.create(TextHelper.optionTranslation(\"seasonOptions\", \"hudDetail\", true)))\n        .withValues(HudDetail.getValues())\n        .withInitialValue(hudDetail)\n        .create(leftButtonX, (buttonStartY + (row * yOffset)), BUTTON_WIDTH, BUTTON_HEIGHT,\n                TextHelper.optionTranslation(\"seasonOptions\", \"hudDetail\"), (b, val) -> this.hudDetail = val);\n\n    CycleButton<Boolean> seasonColorButton = CycleButton.onOffBuilder(seasonColor)\n        .withTooltip(t -> Tooltip.create(TextHelper.optionTranslation(\"colorOptions\", \"enableSeasonNameColor\", true)))\n        .create(rightButtonX, (buttonStartY + (row * yOffset)), BUTTON_WIDTH, BUTTON_HEIGHT,\n                TextHelper.optionTranslation(\"colorOptions\", \"enableSeasonNameColor\"), (b, val) -> this.seasonColor = val);\n\n    widgets.addAll(Arrays.asList(showDayButton, seasonColorButton));\n\n    if (Common.hasSubSeasons()) {\n      row += 1; // Row 4 (enableMinimapIntegration -> Row 2)\n      CycleButton<Boolean> showSubSeasonButton = CycleButton.onOffBuilder(showSubSeason)\n          .withTooltip(t -> Tooltip.create(TextHelper.optionTranslation(\"seasonOptions\", \"showSubSeason\", true)))\n          .create(leftButtonX, (buttonStartY + (row * yOffset)), BUTTON_WIDTH, BUTTON_HEIGHT,\n                  TextHelper.optionTranslation(\"seasonOptions\", \"showSubSeason\"), (b, val) -> this.showSubSeason = val);\n\n      CycleButton<Boolean> showTropicalSeasonButton = CycleButton.onOffBuilder(showTropicalSeason)\n          .withTooltip(t -> Tooltip.create(TextHelper.optionTranslation(\"seasonOptions\", \"showTropicalSeason\", true)))\n          .create(rightButtonX, (buttonStartY + (row * yOffset)), BUTTON_WIDTH, BUTTON_HEIGHT,\n                  TextHelper.optionTranslation(\"seasonOptions\", \"showTropicalSeason\"),\n                  (b, val) -> this.showTropicalSeason = val);\n      widgets.addAll(Arrays.asList(showSubSeasonButton, showTropicalSeasonButton));\n    }\n\n    if (Common.fabricSeasonsLoaded()) {\n      row += 1; //Row 4 (enableMinimapIntegration -> Row 2)\n      dayLengthBox = new EditBox(this.font, leftButtonX + 1, (buttonStartY + (row * yOffset)), BUTTON_WIDTH - 2,\n                                 BUTTON_HEIGHT, Component.literal(String.valueOf(dayLength)));\n      dayLengthBox.setMaxLength(10);\n      dayLengthBox.setValue(String.valueOf(dayLength));\n      dayLengthBox.setResponder((lengthString) -> {\n        if (validate(lengthString)) {\n          dayLengthBox.setTextColor(0xffffff);\n          int currentLength = Integer.parseInt(lengthString);\n\n          if (currentLength != this.newDayLength) {\n            this.newDayLength = currentLength;\n            dayLengthBox.setValue(lengthString);\n          }\n\n          doneButton.active = true;\n        }\n        else {\n          dayLengthBox.setTextColor(16733525);\n          doneButton.active = false;\n        }\n      });\n      dayLengthBox.setHint(Component.literal(\"\" + dayLength).withStyle(ChatFormatting.DARK_GRAY));\n      dayLengthBox.setTooltip(Tooltip.create(TextHelper.optionTranslation(\"seasonOptions\", \"dayLength\", true)));\n      widgets.add(dayLengthBox);\n    }\n\n    if (Common.hasCalendarLoaded()) {\n      row += 1; //Row 5 ((enableMinimapIntegration -> Row 3)\n      CycleButton<Boolean> needCalendarButton = CycleButton.onOffBuilder(needCalendar)\n          .withTooltip(t -> Tooltip.create(TextHelper.optionTranslation(\"seasonOptions\", \"needCalendar\", true)))\n          .create(leftButtonX, (buttonStartY + (row * yOffset)), BUTTON_WIDTH, BUTTON_HEIGHT,\n                  TextHelper.optionTranslation(\"seasonOptions\", \"needCalendar\"), (b, val) -> this.needCalendar = val);\n\n      CycleButton<Boolean> calendarDetailModeButton = CycleButton.onOffBuilder(enableCalendarDetail)\n          .withTooltip(t -> Tooltip.create(TextHelper.optionTranslation(\"seasonOptions\", \"calendarDetailMode\", true)))\n          .create(rightButtonX, (buttonStartY + (row * yOffset)), BUTTON_WIDTH, BUTTON_HEIGHT,\n                  TextHelper.optionTranslation(\"seasonOptions\", \"calendarDetailMode\"), (b, val) -> {\n                this.enableCalendarDetail = val;\n              });\n\n      widgets.addAll(Arrays.asList(needCalendarButton, calendarDetailModeButton));\n    }\n\n    widgets.forEach(this::addRenderableWidget);\n  }\n\n  private boolean inBounds(int length) {\n    int minInt = 0;\n\n    return length >= minInt;\n  }\n\n  public boolean validate(String length) {\n    try {\n      int dayLength = Integer.parseInt(length);\n      return this.inBounds(dayLength);\n    } catch (NumberFormatException formatException) {\n      return false;\n    }\n  }\n}\n
