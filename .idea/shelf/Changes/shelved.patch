ric_1.21.5\")\r\n\r\n    //JourneyMap\r\n    modCompileOnlyApi group: 'info.journeymap', name: 'journeymap-api-fabric', version: project.journeymap_api_version, changing: true\r\n    modCompileOnly(\"maven.modrinth:journeymap:1.21.5-${project.journeymap_version}+fabric\")\r\n\r\n    //FTB Chunks + Dependencies\r\n    modCompileOnly(\"curse.maven:ftb-chunks-fabric-472657:${project.ftb_chunks_fabric_version}\")\r\n    modCompileOnly(\"curse.maven:ftb-library-fabric-438495:${project.ftb_library_fabric_version}\")\r\n    modCompileOnly(\"curse.maven:ftb-teams-fabric-438497:${project.ftb_teams_fabric_version}\")\r\n    modCompileOnly(\"maven.modrinth:architectury-api:${project.architectury_version}+fabric\")\r\n\r\n    //Map Atlases\r\n    modCompileOnly(\"maven.modrinth:map-atlases:fabric_1.21-${project.map_atlases_version}\")\r\n    modCompileOnly(\"maven.modrinth:moonlight:1.21-${project.moonlight_version}-fabric\")\r\n    modCompileOnly(\"maven.modrinth:immediatelyfast:${project.immediatelyfast_version}+1.21.5-fabric\")\r\n\r\n    //Trinkets + Accessories\r\n    modCompileOnly(\"dev.emi:trinkets:${project.trinkets_version}\")\r\n    modCompileOnly \"org.ladysnake.cardinal-components-api:cardinal-components-base:6.1.0\"\r\n    modCompileOnly \"org.ladysnake.cardinal-components-api:cardinal-components-entity:6.1.0\"\r\n\r\n    modCompileOnly(\"io.wispforest:accessories-fabric:${project.accessories_version}\")\r\n    modCompileOnly(\"me.shedaniel.cloth:cloth-config-fabric:${project.cloth_config_version}\")\r\n\r\n    //Config API\r\n    //modApi \"fuzs.forgeconfigapiport:forgeconfigapiport-fabric:${project.forge_config_api_port_version}\"\r\n    //modImplementation(\"maven.modrinth:forge-config-api-port:v${project.forge_config_api_port_version}-${project.minecraft_version}-Fabric\")\r\n    annotationProcessor modCompileOnly(\"io.wispforest:owo-lib:${project.owo_version}\")\r\n    modLocalRuntime \"maven.modrinth:owo-lib:${project.owo_version}\"\r\n    modLocalRuntime(\"