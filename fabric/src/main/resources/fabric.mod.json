{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${version}",
  "name": "${mod_name}",
  "description": "${description}",
  "authors": [
    "${mod_author}"
  ],
  "contact": {
    "repo": "https://github.com/IanMods/SeasonHUD",
    "issues": "https://github.com/IanMods/SeasonHUD/issues"
  },
  "license": "${license}",
  "icon": "${mod_id}.png",
  "environment": "*",
  "entrypoints": {
    "client": [
      "club.iananderson.seasonhud.fabric.client.SeasonHudClientFabric"
    ],
    "main": [
      "club.iananderson.seasonhud.fabric.SeasonHudFabric"
    ],
    "journeymap": [
      "club.iananderson.seasonhud.impl.minimaps.journeymap.JourneymapSeasonPlugin"
    ]
  },
  "mixins": [
    "seasonhud.mixins.json"
  ],
  "depends": {
    "fabricloader": "~${fabric_loader_version}",
    "fabric-api": "*",
    "minecraft": "${fabric_version_range}",
    "java": ">=${java_version}",
    "fabric-key-binding-api-v1": "*",
    "forgeconfigapiport": "*"
  },
  "breaks": {
    "seasons": "<2.4.2-BETA",
    "sereneseasons": "<9.1.0.0",
    "xaerominimap": "<25.2.0",
    "journeymap": "<1.21-6.0.0-beta.25",
    "ftbchunks": "<2101.1.10"
  }
}